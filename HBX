import os
import platform
import sys

# আর্কিটেকচার চেক করার ফাংশন
def get_arch():
    machine = platform.machine().lower()
    if "aarch64" in machine or "arm64" in machine:
        return "64"
    else:
        return "32"

def main():
    # স্ক্রিন ক্লিয়ার করা
    os.system('clear')
    
    arch_type = get_arch()

    if arch_type == "64":
        try:
            # এখানে আপনার নতুন সাইথন করা HBXADMIN.so ফাইলটি ইমপোর্ট হবে
            import HBXADMIN
        except ImportError as e:
            print(f"❌ Error: HBXADMIN.so ফাইলটি খুঁজে পাওয়া যায়নি অথবা আর্কিটেকচার মিলছে না! \n[বিস্তারিত]: {e}")
            sys.exit()
    else:
        # ৩২-বিট ইউজারদের জন্য ওয়ার্নিং
        print("="*45)
        print("❌ দুঃখিত! আপনার ফোনটি ৩২-বিটের।")
        print("🛠️ HBX ADMIN টুলটি বর্তমানে শুধুমাত্র ৬৪-বিটে কাজ করে।")
        print("="*45)
        sys.exit()

    try:
        # ৬৪-বিট হলে আপনার সাইথন ফাইলের ভেতরের লোগো এবং বট রান হবে
        HBXADMIN.professional_logo()
        print("\n\033[1;32m[+] HBX ADMIN বট সফলভাবে রান হচ্ছে...\033[0m")
        HBXADMIN.bot.infinity_polling()
    except Exception as e:
        print(f"Error: {e}")

if __name__ == "__main__":
    main()
